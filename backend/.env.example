# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/stayscape

# JSON Web Token Secret & Expiration
JWT_SECRET=stayscape_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=7d

# Client Application URL (for CORS and Cookies)
CLIENT_URL=http://localhost:3000

# Cloudinary Storage Configuration (Optional - falls back to local disk storage if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
